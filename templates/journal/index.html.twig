{% extends 'base.html.twig' %}

{% block title %}Journal d’activité | Incipit{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/journal.css') }}">
{% endblock %}

{% block body %}
<div class="espace-layout">
    {% include 'components/_sidebar.html.twig' %}

    <main class="espace-contenu bibliotheque journal">
        <header class="profil-entete journal-entete">
            <div>
                <h1 class="titre-page">Journal d’activité</h1>
                <p class="sous-titre-page">Retrouvez les actions effectuées dans votre bibliothèque.</p>
            </div>
            <img src="{{ asset('images/incipit.png') }}" class="bibliotheque-logo" alt="Incipit">
        </header>
        <a class="journal-retour" href="{{ path('app_espace_profil') }}">← Retour au profil</a>

        {# Regroupe les critères dans le même encadré que les autres outils de gestion ; les actions restent sous les champs. #}
        <form method="get" class="journal-filtres">
            <div class="journal-criteres">
                <label for="journal-action">Action
                    <select id="journal-action" name="action">
                        <option value="">Toutes les actions</option>
                        {% for valeur, libelle in actions %}
                            <option value="{{ valeur }}" {{ filtres.action == valeur ? 'selected' : '' }}>{{ libelle }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label for="journal-livre">Livre
                    <input id="journal-livre" type="search" name="livre" maxlength="150" value="{{ filtres.livre }}" placeholder="Titre du livre">
                </label>
                <label for="journal-debut">Du
                    <input id="journal-debut" type="date" name="debut" value="{{ filtres.debut }}">
                </label>
                <label for="journal-fin">Au
                    <input id="journal-fin" type="date" name="fin" value="{{ filtres.fin }}">
                </label>
            </div>
            <div class="journal-actions">
                <button class="bibliotheque-valider" type="submit">Valider</button>
                <a class="bibliotheque-reinitialiser" href="{{ path('app_journal_activite') }}"><span aria-hidden="true">↻</span>Réinitialiser les filtres</a>
            </div>
        </form>

        {% if enAttente %}
            <p class="journal-message" role="status">{{ enAttente }} événement(s) en attente de transmission.</p>
        {% endif %}
        {% if erreur %}
            <p class="journal-message journal-message-erreur" role="alert">{{ erreur }}</p>
        {% else %}
            {# Chaque carte conserve le titre et le compte au moment de l’action, sans dépendre des données actuelles du livre. #}
            <ol class="journal-evenements">
                {% for evenement in evenements %}
                    <li class="journal-evenement">
                        <div class="journal-evenement-entete">
                            <h2>{{ actions[evenement.action]|default('Action sur un livre') }}</h2>
                            <time datetime="{{ evenement.date|date('c') }}">{{ evenement.date|date('d/m/Y à H:i') }}</time>
                        </div>
                        <p class="journal-livre">{{ evenement.livre.titre }}</p>
                        <p class="journal-compte">Par {{ evenement.administrateur.compte }}</p>
                        {% if evenement.details.statut is defined %}
                            <p class="journal-details">Statut : {{ evenement.details.statut }}{% if evenement.details.note is not null %} · Note : {{ evenement.details.note }}/5{% endif %}</p>
                        {% endif %}
                    </li>
                {% else %}
                    <li class="journal-vide">Aucune activité pour ces critères.</li>
                {% endfor %}
            </ol>
            <nav class="journal-pagination" aria-label="Pagination du journal">
                {% if page > 1 %}<a class="journal-bouton journal-bouton-secondaire" href="{{ path('app_journal_activite', filtres|merge({page: page - 1})) }}">← Précédent</a>{% endif %}
                <span>Page {{ page }}</span>
                {% if suite and page < 1000 %}<a class="journal-bouton journal-bouton-secondaire" href="{{ path('app_journal_activite', filtres|merge({page: page + 1})) }}">Suivant →</a>{% endif %}
            </nav>
        {% endif %}
    </main>
</div>
{% endblock %}

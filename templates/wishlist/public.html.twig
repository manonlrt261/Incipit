{% extends 'base.html.twig' %}

{% block title %}Wishlist publique | Incipit{% endblock %}

{% block body %}
<div class="accueil wishlist-publique">
    {# Partage la bannière et l’accès à la connexion des autres pages publiques. #}
    {% include 'accueil/_entete.html.twig' only %}

    <main class="accueil-main">
        <section class="accueil-section">
            <div class="accueil-section-entete">
                <img class="accueil-section-icone" src="{{ asset('images/stars.png') }}" alt="">
                <div class="accueil-section-titres">
                    <h2>Ma wishlist</h2>
                    <p>Les livres que je souhaite lire un jour.</p>
                </div>
                <a class="accueil-lien" href="{{ path('app_accueil') }}">
                    ← Retour à l'accueil
                </a>
            </div>

            {# Affiche uniquement les souhaits publics encore souhaités, avec les cartes de la wishlist personnelle. #}
            {% if souhaits is empty %}
                <p class="accueil-vide">Aucun livre public dans ma wishlist pour le moment.</p>
            {% else %}
                <div class="wishlist-grille">
                    {% for souhait in souhaits %}
                        {% set livre = souhait.livre %}

                        {# Prépare les noms affichés en privilégiant le nom d’affichage de chaque auteur. #}
                        {% set auteurs = [] %}
                        {% for auteur in livre.auteurs %}
                            {% set auteurs = auteurs|merge([
                                auteur.nomAffichage ?: (auteur.prenom ~ ' ' ~ auteur.nom)|trim
                            ]) %}
                        {% endfor %}

                        <article class="wishlist-carte" tabindex="0" data-fiche-souhait="fiche-souhait-{{ souhait.id }}" aria-label="Consulter {{ livre.titre }}">
                            {# Conserve les URL distantes et les chemins absolus ; complète les chemins locaux relatifs. #}
                            <div class="wishlist-couverture">
                                {% if livre.imageCouverture %}
                                    <img
                                        src="{{ livre.imageCouverture starts with 'http' or livre.imageCouverture starts with '/' ? livre.imageCouverture : '/' ~ livre.imageCouverture }}"
                                        alt="Couverture de {{ livre.titre }}"
                                    >
                                {% else %}
                                    <span aria-label="Couverture non renseignée"></span>
                                {% endif %}
                            </div>

                            <h2>{{ livre.titre }}</h2>
                            <p class="wishlist-auteur">{{ auteurs is empty ? 'Auteur non renseigné' : auteurs|join(', ') }}</p>
                            <p class="wishlist-date">
                                <img src="{{ asset('images/calendrier.png') }}" alt="">
                                Ajouté le {{ souhait.dateAjout|date('d/m/Y') }}
                            </p>
                        </article>
                        {% include 'wishlist/_fiche.html.twig' with {souhait: souhait, livre: livre, auteurs: auteurs, publique: true} only %}
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
</div>
{% endblock %}


{% extends 'base.html.twig' %}

{% block title %}Ma bibliothèque - Incipit{% endblock %}

{% block body %}
<main style="max-width: 1100px; margin: 50px auto; padding: 20px;">

    <h1>Ma bibliothèque</h1>

    <p>Retrouvez tous les livres enregistrés dans Incipit.</p>

    <a href="{{ path('app_livre_ajouter') }}">
        Ajouter un livre
    </a>

    {% if livres is empty %}
        <p>Votre bibliothèque est vide pour le moment.</p>
    {% else %}
        <div style="
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 24px;
            margin-top: 30px;
        ">
            {% for livre in livres %}
                <article style="
                    padding: 20px;
                    border: 1px solid #ddd;
                    border-radius: 10px;
                ">
                    {% if livre.imageCouverture %}
                        <img
                            src="{{ livre.imageCouverture }}"
                            alt="Couverture de {{ livre.titre }}"
                            style="width: 100%; height: 250px; object-fit: contain;"
                        >
                    {% endif %}

                    <h2>{{ livre.titre }}</h2>

                    {% if livre.sousTitre %}
                        <p>{{ livre.sousTitre }}</p>
                    {% endif %}

                    {% if livre.auteurs is not empty %}
                        <p>
                            {% for auteur in livre.auteurs %}
                                {{ auteur.nomAffichage }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                    {% endif %}

                    {% if livre.nombrePages %}
                        <p>{{ livre.nombrePages }} pages</p>
                    {% endif %}

                    {% if livre.langue %}
                        <p>Langue : {{ livre.langue }}</p>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}

</main>
{% endblock %}

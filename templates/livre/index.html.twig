{% extends 'base.html.twig' %}

{% block title %}Ma bibliothèque | Incipit{% endblock %}

{% block body %}
<div class="espace-layout">
    {# Réutilise la navigation commune avec l’onglet Bibliothèque actif. #}
    {% include 'components/_sidebar.html.twig' %}

    <main class="espace-contenu bibliotheque">

        {# Recherche par titre, auteur ou ISBN ; les résultats sont filtrés par JavaScript sans rechargement. #}
        <header class="bibliotheque-header">
            <form id="bibliotheque-recherche" class="bibliotheque-recherche" role="search">
                <img src="{{ asset('images/rechercher.png') }}" alt="">
                <input
                    type="search"
                    id="recherche-livre"
                    placeholder="Rechercher un titre, un auteur, un ISBN..."
                    aria-label="Rechercher un livre"
                >
                <button type="submit" aria-label="Lancer la recherche" class="bouton-rechercher">
                    Rechercher
                </button>
            </form>

            <img
                src="{{ asset('images/incipit.png') }}"
                alt="Incipit"
                class="bibliotheque-logo"
            >
        </header>

        <div class="bibliotheque-introduction">
            <div>
                <h1 class="titre-page">Ma bibliothèque</h1>
                <p class="sous-titre-page">Les livres que vous possédez.</p>
            </div>

            {# Ouvre le formulaire commun d’ajout d’un livre. #}
            <button type="button" id="ouvrir-ajout" class="bibliotheque-ajouter">
                Ajouter un livre
            </button>
        </div>

        {# Combine les filtres de genre et de statut avec le tri par auteur ou par date d’ajout. #}
        {% include 'components/_filtres_livres.html.twig' with {genres: genres} only %}

        {# Regroupe le compteur, le repli de la liste et le choix entre grille et liste. #}
        <div class="bibliotheque-outils">
            <p id="bibliotheque-compteur" aria-live="polite">
                {{ livres|length }} livres dans ma bibliothèque
            </p>

            <button type="button" id="bibliotheque-basculer-livres" class="bibliotheque-basculer-livres" aria-expanded="true" aria-controls="bibliotheque-liste-zone" aria-label="Masquer les livres">
                <span class="bibliotheque-ligne-repli" aria-hidden="true"></span>
                <span class="bibliotheque-fleche-repli" aria-hidden="true"></span>
            </button>

            <div class="bibliotheque-vues" aria-label="Mode d'affichage">
                <button
                    type="button"
                    id="vue-grille"
                    class="bibliotheque-vue actif"
                    aria-pressed="true"
                >
                    <img src="{{ asset('images/grille.png') }}" alt="">
                    Grille
                </button>

                <button
                    type="button"
                    id="vue-liste"
                    class="bibliotheque-vue"
                    aria-pressed="false"
                >
                    <img src="{{ asset('images/liste.png') }}" alt="">
                    Liste
                </button>
            </div>
        </div>

        <div id="bibliotheque-liste-zone">
            <section
                id="bibliotheque-livres"
                class="bibliotheque-livres vue-grille"
            >
                {# Expose les données nécessaires à la recherche, aux filtres et à l’ouverture de la fiche de chaque livre. #}
                {% for livre in livres %}

                    <article
                        class="bibliotheque-livre"
                        data-livre-id="{{ livre.id }}"
                        data-auteurs="{{ livre.auteurs|e('html_attr') }}"
                        data-date-ajout="{{ livre.date_creation ? livre.date_creation|date('U') : '' }}"
                        data-recherche="{{ (livre.titre ~ ' ' ~ livre.sous_titre ~ ' ' ~ livre.auteurs ~ ' ' ~ livre.isbn13 ~ ' ' ~ livre.isbn10)|lower|e('html_attr') }}"
                        data-genres="{{ livre.genres|e('html_attr') }}"
                        data-statut="{{ livre.statut|e('html_attr') }}"
                    >
                        {# Affiche une couverture de remplacement lorsque le livre ne possède pas d’image. #}
                        {% if livre.image_couverture %}
                            <img
                                class="bibliotheque-couverture"
                                src="{{ asset(livre.image_couverture) }}"
                                alt="Couverture de {{ livre.titre }}"
                            >
                        {% else %}
                            <div class="bibliotheque-couverture bibliotheque-sans-couverture" aria-label="Couverture non renseignée"></div>
                        {% endif %}

                        <div class="bibliotheque-livre-infos">
                            <h2>{{ livre.titre }}</h2>

                            <p class="bibliotheque-auteur">
                                {{ livre.auteurs ?: 'Auteur non renseigné' }}
                            </p>

                            {# Réutilise le badge de statut commun aux pages de livres et de lectures. #}
                            {% include 'components/_badge_lecture.html.twig' with {
                                statut: livre.statut
                            } only %}
                        </div>
                    </article>
                {% endfor %}
            </section>

            {# Ce message est affiché par JavaScript si aucun livre ne correspond aux critères. #}
            <p id="bibliotheque-aucun-resultat" class="bibliotheque-vide" hidden>
                Aucun livre ne correspond à votre recherche ou à vos filtres.
            </p>
        </div>

        {# Conserve l’accès aux titres retirés de la collection et à leur historique. #}
        <section class="bibliotheque-retires">
            <button
                type="button"
                id="basculer-retires"
                class="bibliotheque-retires-entete"
                aria-expanded="true"
                aria-controls="contenu-retires"
            >
                <img src="{{ asset('images/poubelle.png') }}" alt="">

                <span class="bibliotheque-retires-titre">
                    <strong>Livres retirés de ma collection</strong>
                    <small>
                        Ces livres ne sont plus dans votre bibliothèque,
                        mais leur historique est conservé.
                    </small>
                </span>

                <span id="chevron-retires" aria-hidden="true">⌃</span>
            </button>

            <div id="contenu-retires" class="bibliotheque-retires-liste">
                {% for livre in livresRetires %}
                    <article class="bibliotheque-livre-retire">
                        {% if livre.image_couverture %}
                            <img
                                src="{{ asset(livre.image_couverture) }}"
                                alt="Couverture de {{ livre.titre }}"
                            >
                        {% else %}
                            <div class="bibliotheque-couverture-retire-vide"></div>
                        {% endif %}

                        <div>
                            <h3>{{ livre.titre }}</h3>
                            <p>{{ livre.auteurs ?: 'Auteur non renseigné' }}</p>
                        </div>
                    </article>
                {% else %}
                    <p class="bibliotheque-vide">
                        Aucun livre retiré de votre collection.
                    </p>
                {% endfor %}
            </div>
        </section>
    </main>
</div>

{# Charge les fenêtres communes d’ajout, de modification et de consultation des livres. #}
{% include 'livre/_modal_ajout.html.twig' %}
{% include 'livre/_modal_details.html.twig' %}

{% endblock %}

<!DOCTYPE html>
<html>
    <head>
        {# Définit l’encodage du texte et adapte la largeur de chaque page à l’écran utilisé. #}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {# Chaque template enfant peut définir son propre titre dans l’onglet du navigateur. #}
        <title>{% block title %}Welcome!{% endblock %}</title>

        <link
            rel="icon"
            href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {# Point d’extension pour les styles spécifiques ; les styles communs sont importés par app.js. #}
        {% block stylesheets %}
        {% endblock %}

        {# Charge l’entrée JavaScript commune et conserve les blocs remplaçables par les templates enfants. #}
        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}

        {# Active le rechargement automatique uniquement lorsque le serveur fournit une URL FrankenPHP. #}
        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    <body>
        {# Accueille le contenu propre à chaque page qui hérite de ce template. #}
        {% block body %}{% endblock %}
    </body>
</html>

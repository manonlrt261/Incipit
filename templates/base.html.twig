<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {# Chaque page définit son titre ; Incipit sert de titre par défaut. #}
        <title>{% block title %}Incipit{% endblock %}</title>

        <link
            rel="icon"
            type="image/png"
            href="{{ asset('images/logobrun.png') }}"
        >

        {# Point d’extension pour les styles spécifiques ; les styles communs sont importés par app.js. #}
        {% block stylesheets %}{% endblock %}

        {# Charge app.js via AssetMapper ; les pages peuvent compléter les entrées dans le bloc importmap. #}
        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}

        {# Active le rechargement automatique uniquement lorsque le serveur fournit une URL FrankenPHP. #}
        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}

        {% if frankenphp_hot_reload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    <body>
        {% block body %}{% endblock %}
    </body>
</html>

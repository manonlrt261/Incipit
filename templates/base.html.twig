<!DOCTYPE html>
<html>
    <head>
        {# Définit l’encodage du texte et adapte la largeur de chaque page à l’écran utilisé. #}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {# Chaque template enfant peut définir son propre titre dans l’onglet du navigateur. #}
        <title>{% block title %}Welcome!{% endblock %}</title>

        {# Affiche le logo Incipit dans l’onglet du navigateur sur toutes les pages. #}
        <link
            rel="icon"
            type="image/png"
            href="{{ asset('images/logobrun.png') }}"
        >

        {# Point d’extension pour les styles spécifiques ; les styles communs sont importés par app.js. #}
        {% block stylesheets %}
        {% endblock %}

        {# Charge l’entrée JavaScript commune et conserve les blocs remplaçables par les templates enfants. #}
        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}

        {# Active le rechargement automatique uniquement lorsque le serveur fournit une URL FrankenPHP. #}
        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    <body>
        {# Accueille le contenu propre à chaque page qui hérite de ce template. #}
        {% block body %}{% endblock %}
    </body>
</html>

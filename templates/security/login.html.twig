{% extends 'base.html.twig' %}

{% block title %}Connexion | Incipit{% endblock %}

{% block body %}
<a href="{{ path('app_accueil') }}" class="login-back-home">
    ← Retour à l'accueil
</a>

<main class="login-page">
    <div class="login-container">
        <img src="{{ asset('images/incipit.png') }}" alt="Incipit" class="login-logo">

        <p class="login-subtitle">
            Connectez-vous pour accéder à votre bibliothèque.
        </p>

        {# Envoie les identifiants à Symfony Security pour ouvrir la session. #}
        <form method="post" action="{{ path('app_login') }}" class="login-card">
            <div class="login-field">
                <label for="username">Adresse e-mail</label>
                <div class="login-input-wrapper">
                    <img src="{{ asset('images/mail.png') }}" alt="">

                    {# Conserve la dernière adresse saisie après un échec de connexion. #}
                    <input
                        type="email"
                        id="username"
                        name="_username"
                        value="{{ last_username }}"
                        placeholder="Votre adresse e-mail"
                        autocomplete="email"
                        required
                    >
                </div>
            </div>

            <div class="login-field">
                <label for="password">Mot de passe</label>
                <div class="login-input-wrapper">
                    <img src="{{ asset('images/cadenas2.png') }}" alt="">
                    <input
                        type="password"
                        id="password"
                        name="_password"
                        placeholder="Votre mot de passe"
                        autocomplete="current-password"
                        required
                    >

                    {# Le script bascule la visibilité du mot de passe et synchronise l’icône avec le libellé accessible. #}
                    <button
                        type="button"
                        data-reset-password-toggle="password"
                        aria-controls="password"
                        class="login-password-toggle"
                        aria-label="Afficher le mot de passe"
                        aria-pressed="false"
                    >
                        <img
                            src="{{ asset('images/afficher2.png') }}"
                            data-image-afficher="{{ asset('images/afficher2.png') }}"
                            data-image-masquer="{{ asset('images/masquer2.png') }}"
                            alt=""
                        >
                    </button>
                </div>
            </div>

            {# Transmet le jeton vérifié par Symfony lors de l’authentification. #}
            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('authenticate') }}"
            >

            <button type="submit" class="btn-primary login-submit">
                Se connecter
            </button>

            <a href="{{ path('app_forgot_password_request') }}" class="login-forgot-password">Mot de passe oublié ?</a>

            {# Affiche le message d’échec traduit renvoyé par Symfony Security. #}
            {% if error %}
                <p class="login-error" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </p>
            {% endif %}
        </form>
    </div>
</main>
{% endblock %}

{# Charge les commandes d’affichage du mot de passe, y compris après une navigation Turbo. #}
{% block importmap %}
    {{ importmap(['app', 'reset-password']) }}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Mes prêts | Incipit{% endblock %}

{% block body %}
<div class="espace-layout">
    {% include 'components/_sidebar.html.twig' %}

    <main
        id="page-mes-prets"
        class="espace-contenu bibliotheque page-prets"
    >
        <header class="bibliotheque-header">
            {# Filtre les prêts par titre, saga, auteur ou emprunteur sans recharger la page. #}
            <form id="prets-formulaire-recherche" class="bibliotheque-recherche" role="search">
                <img
                    src="{{ asset('images/rechercher.png') }}"
                    alt=""
                >
                <input
                    type="search"
                    id="prets-recherche"
                    placeholder="Rechercher un livre, une saga, un auteur ou un contact..."
                    aria-label="Rechercher un prêt par livre, auteur ou contact"
                >
                <button type="submit" aria-label="Lancer la recherche" class="bouton-rechercher">Rechercher</button>
            </form>

            <img
                src="{{ asset('images/incipit.png') }}"
                alt="Incipit"
                class="bibliotheque-logo"
            >
        </header>

        {# Change d’onglet au clic ou au clavier sans recharger la page. #}
        <div class="prets-onglets" role="tablist" aria-label="Prêts et contacts">
            <button
                id="prets-tab-prets"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="prets-panneau-prets"
                tabindex="0">Mes prêts</button>
            <button
                id="prets-tab-contacts"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="prets-panneau-contacts"
                tabindex="-1">Contacts</button>
        </div>

        <section id="prets-panneau-prets" role="tabpanel" aria-labelledby="prets-tab-prets">
            <div class="prets-introduction">
                <div>
                    <h1 class="titre-page">Mes prêts</h1>
                    <p class="sous-titre-page">Retrouvez et gérez tous les livres que vous avez prêtés.</p>
                </div>

                {# Ouvre la fenêtre d’ajout et prépare un formulaire vide. #}
                <button
                    type="button"
                    id="ouvrir-ajout-pret"
                    class="btn btn-secondary prets-bouton-ajouter"
                >
                    Ajouter un prêt
                </button>
            </div>

            {# Filtre les prêts par genre et les trie par prénom du contact, auteur ou date réelle du prêt. #}
            {% include 'components/_filtres_livres.html.twig' with {
                genres: genres,
                prefixe: 'prets-',
                mode_prets: true
            } only %}

            {# Annonce le nombre de prêts et suit les résultats des filtres sans rechargement. #}
            <p id="prets-compteur" aria-live="polite">
                {{ prets|length }} {{ prets|length == 1 ? 'livre prêté' : 'livres prêtés' }}
            </p>

            <section
                class="prets-liste"
                aria-label="Liste de mes prêts"
            >
                {# Le texte de recherche réunit titre, saga, auteur et nom complet du contact ; son identifiant relie le prêt à la bonne personne. #}
                {% for pret in prets %}
                    <article
                        class="prets-carte"
                        data-pret-id="{{ pret.id }}"
                        data-contact-id="{{ pret.contactId }}"
                        data-auteurs="{{ pret.auteur|e('html_attr') }}"
                        data-genres="{{ pret.genres|e('html_attr') }}"
                        data-contact-prenom="{{ pret.prenomContact|e('html_attr') }}"
                        data-contact-nom="{{ pret.nomContact|e('html_attr') }}"
                        data-date-pret="{{ pret.datePret }}"
                        data-saga="{{ pret.saga }}"
                        data-recherche="{{ (pret.titre ~ ' ' ~ pret.saga ~ ' ' ~ pret.auteur ~ ' ' ~ pret.emprunteur)|lower|e('html_attr') }}"
                    >
                        <div class="prets-informations">
                            <h2>{{ pret.titre }}</h2>

                            <p class="prets-auteur">
                                {{ pret.auteur }}
                            </p>

                            <p class="prets-emprunteur">
                                Prêté à :
                                <strong>{{ pret.emprunteur }}</strong>
                            </p>
                        </div>

                        {# Transmet l’adresse de suppression et un jeton propre à chaque prêt pour la confirmation. #}
                        <button
                            type="button"
                            class="prets-supprimer"
                            data-id="{{ pret.id }}"
                            data-titre="{{ pret.titre|e('html_attr') }}"
                            data-url="{{ path('app_prets_supprimer', {id: pret.id}) }}"
                            data-token="{{ csrf_token('supprimer_pret_' ~ pret.id) }}"
                            aria-label="Supprimer le prêt de {{ pret.titre }}"
                            title="Supprimer le prêt"
                        >
                            <img
                                src="{{ asset('images/poubelle.png') }}"
                                alt=""
                            >
                        </button>
                    </article>
                {% endfor %}
            </section>

            {# Distingue une recherche sans résultat d’une liste ne contenant encore aucun prêt. #}
            <p
                id="prets-aucun-resultat"
                class="prets-message-vide"
                hidden
            >
                Aucun prêt ne correspond à votre recherche.
            </p>

            <p
                id="prets-liste-vide"
                class="prets-message-vide"
                {% if prets is not empty %}hidden{% endif %}
            >
                Vous n'avez aucun prêt enregistré.
            </p>

            {# Affiche les erreurs de suppression sans quitter la page. #}
            <p
                id="prets-message-erreur"
                class="prets-message-erreur"
                role="alert"
                hidden
            ></p>
        </section>

        {# Les contacts existent indépendamment des prêts ; les actions sont enregistrées sans rechargement. #}
        <section id="prets-panneau-contacts" role="tabpanel" aria-labelledby="prets-tab-contacts" hidden>
            <div class="prets-introduction">
                <div>
                    <h2 class="titre-page">Mes contacts</h2>
                    <p class="sous-titre-page">Retrouvez les personnes à qui vous prêtez vos livres.</p>
                </div>
                <button type="button" id="ouvrir-ajout-contact" class="prets-bouton-ajouter">Ajouter un contact</button>
            </div>

            <p id="prets-contacts-message" role="status" hidden></p>

            {# Les identifiants et routes servent aux actions des contacts ; les images sont reprises pour les cartes créées sans rechargement. #}
            <div
                id="prets-contacts"
                class="prets-contacts"
                data-image-modifier="{{ asset('images/modifier.png') }}"
                data-image-supprimer="{{ asset('images/poubelle.png') }}">
                {% for contact in contacts %}
                    <article
                        class="prets-contact"
                        data-contact-id="{{ contact.id }}"
                        data-prenom="{{ contact.prenom }}"
                        data-nom="{{ contact.nom }}"
                        data-encours="{{ contact.encours }}"
                        data-total="{{ contact.total }}"
                        data-modifier="{{ contact.modifier }}"
                        data-details="{{ contact.details }}"
                        data-supprimer="{{ contact.supprimer }}"
                    >
                        <div>
                            <h3>{{ (contact.prenom ~ ' ' ~ contact.nom)|trim }}</h3>
                            <p>{{ contact.encours }} prêt{{ contact.encours > 1 ? 's' : '' }} en cours</p>
                        </div>
                        <div class="prets-contact-actions">
                            {# Ouvre la liste des prêts de ce contact dans une fenêtre, sans quitter l’onglet Contacts. #}
                            <button
                                type="button"
                                class="prets-contact-voir"
                                data-action-contact="voir"
                                aria-label="Voir les prêts de {{ contact.prenom }} {{ contact.nom }}">Voir les prêts</button>
                            <button
                                type="button"
                                data-action-contact="modifier"
                                aria-label="Modifier {{ contact.prenom }} {{ contact.nom }}"><img
                                src="{{ asset('images/modifier.png') }}"
                                alt=""></button>
                            <button
                                type="button"
                                data-action-contact="supprimer"
                                aria-label="Supprimer {{ contact.prenom }} {{ contact.nom }}"><img
                                src="{{ asset('images/poubelle.png') }}"
                                alt=""></button>
                        </div>
                    </article>
                {% endfor %}
            </div>
            <p id="prets-contacts-vide" {% if contacts is not empty %}hidden{% endif %}>Aucun contact enregistré pour le moment.</p>
        </section>
    </main>
</div>

{# Demande une confirmation avant la suppression ; le JavaScript y reprend le titre du prêt sélectionné. #}
<dialog
    id="modal-suppression-pret"
    class="prets-modale"
    aria-labelledby="prets-suppression-titre"
>
    <h2 id="prets-suppression-titre">
        Supprimer ce prêt ?
    </h2>

    <p id="prets-suppression-description">
        Voulez-vous vraiment supprimer ce prêt ?
    </p>

    <div class="prets-modale-actions">
        <button
            type="button"
            id="annuler-suppression-pret"
            class="prets-bouton-annuler"
        >
            Annuler
        </button>

        <button
            type="button"
            id="confirmer-suppression-pret"
            class="prets-bouton-supprimer"
        >
            Supprimer
        </button>
    </div>
</dialog>

{# Permet de prêter un livre possédé ou de saisir librement un titre absent de la bibliothèque. #}
<dialog
    id="modal-ajout-pret"
    class="prets-modale"
    aria-labelledby="prets-ajout-titre"
>
    <div class="prets-modale-entete">
        <h2 id="prets-ajout-titre">
            Ajouter un prêt
        </h2>

        {% include 'components/_bouton_fermer.html.twig' with {id: 'fermer-ajout-pret'} only %}
    </div>

    {# Envoie les informations du prêt avec le jeton vérifié par le serveur. #}
    <form id="form-ajout-pret" action="{{ path('app_prets_ajouter') }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('ajouter_pret') }}">
        <div class="prets-champ">
            <label for="pret-titre">Titre</label>
            <input
                id="pret-titre"
                name="titre"
                type="text"
                maxlength="255"
                required
                autofocus
                autocomplete="off"
                aria-describedby="pret-recherche-aide"
                aria-controls="pret-livres-possedes"
            >
            {# Le JavaScript renseigne cet identifiant seulement lorsqu’un livre possédé est sélectionné. #}
            <input type="hidden" id="pret-livre-id" name="livre_id">
            <small id="pret-recherche-aide">Recherchez un titre, un auteur ou une saga dans votre bibliothèque, ou saisissez un autre livre.</small>
            <div id="pret-livres-possedes" class="prets-suggestions" aria-label="Livres de ma bibliothèque" hidden>
                {# Prépare les livres suggérés avec leurs auteurs, en utilisant prénom et nom si le nom d’affichage manque. #}
                {% for livre in livresPossedes %}
                    {% set nomsAuteurs = livre.auteurs
                        |map(auteur => auteur.nomAffichage ?: (auteur.prenom ~ ' ' ~ auteur.nom)|trim)
                        |join(', ')
                    %}
                    <button
                        type="button"
                        class="prets-suggestion"
                        data-livre-id="{{ livre.id }}"
                        data-titre="{{ livre.titre }}"
                        data-auteur="{{ nomsAuteurs }}"
                        data-saga="{{ livre.saga }}"
                    >
                        <strong>{{ livre.titre }}</strong>
                        <span>{{ nomsAuteurs ?: 'Auteur non renseigné' }}</span>
                    </button>
                {% endfor %}
                <p id="pret-suggestions-vide" role="status" hidden>Aucun livre trouvé dans votre bibliothèque. Vous pouvez saisir le titre librement.</p>
            </div>
        </div>
        <div class="prets-champ">
            <label for="pret-auteur">Auteur <span>(facultatif)</span></label>
            <input id="pret-auteur" name="auteur" type="text" maxlength="255">
        </div>

        {# La saisie reste libre ; l’identifiant masqué distingue les contacts homonymes proposés par JavaScript. #}
        <div class="prets-champ">
            <label for="pret-emprunteur">Personne à qui vous l’avez prêté</label>
            <input
                id="pret-emprunteur"
                name="emprunteur"
                type="text"
                maxlength="255" required
                autocomplete="off"
                aria-controls="pret-contacts-suggestions"
                aria-describedby="pret-contact-aide">
            <input type="hidden" id="pret-contact-id" name="contact_id">
            <small id="pret-contact-aide">Saisissez un prénom puis choisissez la personne dans les contacts proposés, ou saisissez un nouveau contact.</small>
            <div id="pret-contacts-suggestions" class="prets-suggestions" aria-label="Contacts enregistrés" hidden></div>
        </div>

        {# Conserve les erreurs de validation dans la fenêtre pour permettre de corriger la saisie. #}
        <p id="prets-ajout-erreur" class="prets-message-erreur" role="alert" hidden></p>

        <div class="prets-modale-actions">
            <button type="button" id="annuler-ajout-pret" class="prets-bouton-annuler">Annuler</button>
            <button type="submit" id="enregistrer-ajout-pret" class="prets-bouton-ajouter">Enregistrer le prêt</button>
        </div>
    </form>
</dialog>

{# Formulaire partagé pour créer un contact ou modifier le prénom et le nom d’un contact existant. #}
<dialog id="modal-contact" class="prets-modale" aria-labelledby="contact-titre">
    <div class="prets-modale-entete">
        <h2 id="contact-titre">Ajouter un contact</h2>
        <button type="button" data-fermer-contact class="modal-bouton-fermer" aria-label="Fermer">×</button>
    </div>
    <form id="form-contact" action="{{ path('app_prets_contact_ajouter') }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('gerer_contacts') }}">
        <input type="hidden" id="contact-id" name="id">
        <div class="prets-champ">
            <label for="contact-prenom">Prénom</label>
            <input type="text" id="contact-prenom" name="prenom" maxlength="255" required autocomplete="given-name">
        </div>
        <div class="prets-champ">
            <label for="contact-nom">Nom <span>(facultatif)</span></label>
            <input type="text" id="contact-nom" name="nom" maxlength="255" autocomplete="family-name">
        </div>
        <p id="contact-erreur" role="alert" hidden></p>

        <div class="prets-modale-actions">
            <button type="button" data-fermer-contact class="prets-bouton-annuler">Annuler</button>
            <button type="submit" class="prets-bouton-ajouter">Enregistrer</button>
        </div>
    </form>
</dialog>

{# La confirmation relit les prêts associés : un contact encore utilisé ne peut pas être supprimé. #}
<dialog id="modal-suppression-contact" class="prets-modale" aria-labelledby="suppression-contact-titre">
    <h2 id="suppression-contact-titre">Supprimer ce contact ?</h2>
    <p id="suppression-contact-description" role="status"></p>
    <p id="suppression-contact-erreur" role="alert" hidden></p>
    <div class="prets-modale-actions">
        <button type="button" id="annuler-suppression-contact" class="prets-bouton-annuler">Annuler</button>
        <button type="button" id="confirmer-suppression-contact" class="prets-bouton-supprimer" disabled>Supprimer définitivement</button>
    </div>
</dialog>

{# Consulte les prêts du contact sélectionné, indépendamment des filtres de l’onglet Mes prêts. #}
<dialog id="modal-prets-contact" class="prets-modale" aria-labelledby="contact-prets-titre">
    <header class="prets-modale-entete">
        <h2 id="contact-prets-titre">Prêts du contact</h2>
        {% include 'components/_bouton_fermer.html.twig' with {id: 'fermer-prets-contact'} only %}
    </header>

    {# Le JavaScript remplit la liste à chaque ouverture et ne propose aucune action de modification du prêt. #}
    <div id="contact-liste-prets" class="prets-liste"></div>
    <p id="contact-prets-vide" class="prets-message-vide" hidden>Aucun prêt enregistré pour ce contact.</p>
</dialog>
{% endblock %}

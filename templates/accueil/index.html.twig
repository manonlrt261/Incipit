{% extends 'base.html.twig' %}

{% block title %}Accueil - Incipit{% endblock %}

{% block body %}
<div class="accueil accueil-public">

    {# Réutilise l’en-tête public et son lien de connexion. #}
    {% include 'accueil/_entete.html.twig' only %}

    <main class="accueil-main">

        {# Présente le message de bienvenue et le parchemin entre la bannière et les sections publiques. #}
        <div class="accueil-introduction">
            <div class="accueil-livre-rond">
                <img src="{{ asset('images/parchemin.png') }}" alt="">
            </div>

            <p>Bienvenue dans mon univers littéraire.</p>
            <span class="accueil-trait"></span>
        </div>

        {# Affiche les livres favoris uniquement si cette section est rendue publique dans les paramètres. #}
        {% if visibilite.favoris %}
            <section class="accueil-section">
                <div class="accueil-section-entete">
                    <img class="accueil-section-icone"
                         src="{{ asset('images/hearts.png') }}"
                         alt="">

                    <div class="accueil-section-titres">
                        <h2>Mes livres préférés</h2>
                        <p>Mes livres notés 5 étoiles.</p>
                    </div>

                    <a class="accueil-lien"
                       href="{{ path('app_livres_mieux_notes') }}">
                        Voir tous les livres
                    </a>
                </div>

                {# Prévoit un message lorsqu’aucun livre favori n’est disponible. #}
                {% if livres is empty %}
                    <p class="accueil-vide">
                        Aucun livre noté 5 étoiles pour le moment.
                    </p>
                {% else %}
                    <div class="accueil-grille-livres">
                        {% for livre in livres %}
                            {# Réutilise la carte commune en affichant la note du livre favori. #}
                            {% include 'accueil/_carte_livre.html.twig' with {livre: livre, note: livre.note} only %}
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

        {% endif %}
        {# Affiche le classement annuel des auteurs si sa visibilité publique est activée. #}
        {% if visibilite.auteurs %}
            <section class="accueil-section">
                <div class="accueil-section-entete">
                    <img class="accueil-section-icone"
                         src="{{ asset('images/autors.png') }}"
                         alt="">

                    <div class="accueil-section-titres">
                        <h2>Mes 5 auteurs les plus lus de l’année</h2>
                        <p>Les auteurs que j’ai le plus lus cette année.</p>
                    </div>
                </div>

                {# Prévoit un message lorsqu’aucune lecture terminée ne permet de classer les auteurs. #}
                {% if auteurs is empty %}
                    <p class="accueil-vide">
                        Aucune lecture terminée cette année.
                    </p>
                {% else %}
                    <div class="accueil-grille-auteurs">
                        {% for auteur in auteurs %}
                            <div class="accueil-auteur">
                                <h3>{{ auteur.nom_affichage }}</h3>
                                <p>
                                    {{ auteur.nombre_lectures }}
                                    {{ auteur.nombre_lectures == 1 ? 'lecture' : 'lectures' }}
                                </p>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

        {% endif %}
        {# Affiche les souhaits publics si la section wishlist est visible sur l’accueil. #}
        {% if visibilite.wishlist %}
            <section class="accueil-section">
                <div class="accueil-section-entete">
                    <img class="accueil-section-icone"
                         src="{{ asset('images/stars.png') }}"
                         alt="">

                    <div class="accueil-section-titres">
                        <h2>Ma wishlist</h2>
                        <p>Les livres que j’aimerais découvrir prochainement.</p>
                    </div>

                    <a class="accueil-lien"
                       href="{{ path('app_wishlist') }}">
                        Voir toute la wishlist
                    </a>
                </div>

                {# Prévoit un message lorsqu’aucun souhait public n’est disponible. #}
                {% if wishlist is empty %}
                    <p class="accueil-vide">
                        Aucun livre dans ma wishlist pour le moment.
                    </p>
                {% else %}
                    <div class="accueil-grille-livres">
                        {% for livre in wishlist %}
                            {# Réutilise la carte commune sans étoiles pour les livres souhaités. #}
                            {% include 'accueil/_carte_livre.html.twig' with {livre: livre, note: null} only %}
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

        {% endif %}
    </main>
</div>
{% endblock %}

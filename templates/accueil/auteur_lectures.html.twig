{% extends 'base.html.twig' %}
{% block title %}{{ auteur.nom_affichage }} — Lectures {{ annee }} | Incipit{% endblock %}
{% block body %}
<div class="accueil">
    {% include 'accueil/_entete.html.twig' only %}
    <main class="accueil-main">
        <section class="accueil-section">
            <div class="accueil-section-entete">
                <img class="accueil-section-icone" src="{{ asset('images/autors.png') }}" alt="">
                <div class="accueil-section-titres">
                    <h2>{{ auteur.nom_affichage }}</h2>
                    <p>Mes lectures terminées en {{ annee }}.</p>
                </div>
                <a class="accueil-lien" href="{{ path('app_accueil') }}">← Retour à l’accueil</a>
            </div>
            {# Chaque relecture conserve la note et l’avis propres à sa session de cette année. #}
            <div class="accueil-grille-livres">
                {% for lecture in lectures %}
                    <article class="accueil-carte-livre">
                        <div class="accueil-couverture">
                            {% if lecture.image_couverture %}
                                <img src="{{ lecture.image_couverture starts with 'http' or lecture.image_couverture starts with '/' ? lecture.image_couverture : '/' ~ lecture.image_couverture }}" alt="Couverture de {{ lecture.titre }}">
                            {% else %}
                                <span>Couverture indisponible</span>
                            {% endif %}
                        </div>
                        <h3>{{ lecture.titre }}</h3>
                        <p>{{ auteur.nom_affichage }}</p>
                        {% if lecture.note is not null %}<p class="accueil-lecture-note">Note : {{ lecture.note|number_format(1, ',', ' ') }}/5</p>{% endif %}
                        {# N’affiche ni rubrique ni espace réservé lorsque l’avis est vide. #}
                        {% if lecture.avis|default('')|trim is not empty %}
                            <div class="accueil-lecture-avis"><h4>Commentaire</h4><p>{{ lecture.avis|nl2br }}</p></div>
                        {% endif %}
                    </article>
                {% else %}
                    <p class="accueil-vide">Aucune lecture terminée cette année pour cet auteur.</p>
                {% endfor %}
            </div>
        </section>
    </main>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Livres les mieux notés - Incipit{% endblock %}

{% block body %}
{# Les attributs d’édition permettent au script de sauvegarder les choix avant de revenir au profil. #}
<div class="accueil"
    {% if edition|default(false) %}
        id="edition-accueil"
        data-url="{{ path('app_accueil_ordre') }}"
        data-token="{{ csrf_token('ordre_accueil') }}"
        data-retour="{{ path('app_espace_profil') }}#visibilite"
    {% endif %}
>
    {% include 'accueil/_edition_commandes.html.twig' %}

    {% include 'accueil/_entete.html.twig' only %}

    <main class="accueil-main">
        <section class="accueil-section">
            <div class="accueil-section-entete">
                <img class="accueil-section-icone"
                     src="{{ asset('images/hearts.png') }}"
                     alt="">

                <div class="accueil-section-titres">
                    <h2>Livres les mieux notés</h2>
                    <p>Mes livres notés 5 étoiles.</p>
                </div>

                <a class="accueil-lien" {% if edition|default(false) %}data-edition-navigation{% endif %} href="{{ path(edition|default(false) ? 'app_accueil_edition' : 'app_accueil') }}">
                    ← Retour à l'accueil
                </a>
            </div>

            {# Affiche un message si la liste des livres notés cinq étoiles est vide. #}
            {% if livres is empty %}
                <p class="accueil-vide">
                    Aucun livre noté 5 étoiles pour le moment.
                </p>
            {% else %}
                <div class="accueil-grille-livres" {% if edition|default(false) %}data-ordre-section="favoris"{% endif %}>
                    {# Affiche tous les favoris avec la carte commune et leur note de cinq étoiles. #}
                    {% for livre in livres %}
                        {% include 'accueil/_carte_livre.html.twig' with {livre: livre, note: 5} only %}
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
</div>
{% endblock %}

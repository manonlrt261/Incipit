{# Réutilise le bouton de couverture avec un identifiant propre à la fenêtre et un libellé personnalisable. #}
<button
    type="button"
    id="{{ id }}"
    class="bouton-couverture"
>
    <img src="{{ asset('images/image.png') }}" alt="">
    {{ texte|default('Ajouter une couverture') }}
</button>

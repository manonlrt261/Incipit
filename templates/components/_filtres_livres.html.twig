{# Partage les filtres de genre et de statut et les tris ; les prêts remplacent le statut par le tri des contacts. #}
{# Préserve les identifiants de chaque page et indique au JavaScript quelle date utiliser pour le tri. #}
{% set prefixe = prefixe|default('') %}
{% set mode_prets = mode_prets|default(false) %}
{% set avec_note = avec_note|default(false) %}
<form id="{{ prefixe ? prefixe ~ 'filtres' : 'bibliotheque-filtres' }}" data-filtres-livres data-champ-date="{{ mode_prets ? 'datePret' : 'dateAjout' }}" class="bibliotheque-filtres">
    <div class="bibliotheque-selects">
        <label class="bibliotheque-select">
            <span class="sr-only">Genre</span>
            <select id="{{ prefixe }}filtre-genre" data-filtre-genre>
                <option value="">Genre</option>
                {% for genre in genres %}
                    <option value="{{ genre.nom }}">{{ genre.nom }}</option>
                {% endfor %}
            </select>
        </label>

        {% if mode_prets %}
            {# Les contacts se trient par prénom, puis par nom en cas d’égalité. #}
            <label class="bibliotheque-select">
                <span class="sr-only">Contact</span>
                <select id="{{ prefixe }}tri-contact" data-tri-contact>
                    <option value="">Contact</option>
                    <option value="asc">Contact : A à Z</option>
                    <option value="desc">Contact : Z à A</option>
                </select>
            </label>
        {% else %}
            <label class="bibliotheque-select">
                <span class="sr-only">Statut de lecture</span>
                <select id="{{ prefixe }}filtre-statut" data-filtre-statut>
                    <option value="">Statut de lecture</option>
                    <option value="Pas commencé">Pas commencé</option>
                    <option value="En cours">En cours</option>
                    <option value="En pause">En pause</option>
                    <option value="Terminé">Terminé</option>
                    <option value="À lire">À lire</option>
                    <option value="Abandonné">Abandonné</option>
                </select>
            </label>
        {% endif %}

        <label class="bibliotheque-select">
            <span class="sr-only">Auteurs</span>
            <select id="{{ prefixe }}tri-auteurs" data-tri-auteurs>
                <option value="">Auteurs</option>
                <option value="asc">Auteurs : A à Z</option>
                <option value="desc">Auteurs : Z à A</option>
            </select>
        </label>

        <label class="bibliotheque-select">
            <span class="sr-only">{{ mode_prets ? 'Date de prêt' : 'Date d’ajout' }}</span>
            <select id="{{ prefixe }}tri-date-{{ mode_prets ? 'pret' : 'ajout' }}" data-tri-date>
                <option value="">{{ mode_prets ? 'Date de prêt' : 'Date d’ajout' }}</option>
                <option value="desc">Plus récents</option>
                <option value="asc">Plus anciens</option>
            </select>
        </label>

        {% if avec_note %}
            {# Les tranches regroupent les décimales : 4 inclut toutes les notes de 4 à moins de 5. #}
            <label class="bibliotheque-select">
                <span class="sr-only">Note</span>
                <select id="{{ prefixe }}filtre-note" data-filtre-note>
                    <option value="">Note</option>
                    <option value="asc">Ordre croissant</option>
                    <option value="desc">Ordre décroissant</option>
                    {% for note in 0..5 %}
                        <option value="{{ note }}">{{ note }}*</option>
                    {% endfor %}
                </select>
            </label>
        {# Avec le filtre de note, les deux actions passent ensemble sous les menus. #}
    </div>
    <div class="lectures-filtres-actions">
        {% endif %}
        <button type="submit" class="bibliotheque-valider">
            Valider
        </button>
    {% if not avec_note %}
    </div>
    {% endif %}

    {# Le JavaScript efface la recherche et les critères sans soumettre à nouveau la page. #}
    <button type="button" id="{{ prefixe }}reinitialiser-filtres" data-reinitialiser-filtres class="bibliotheque-reinitialiser">
        <span aria-hidden="true">↻</span>
        Réinitialiser les filtres
    </button>
    {% if avec_note %}
    </div>
    {% endif %}
</form>

{# Associe le statut de lecture à sa classe de couleur, en acceptant les variantes sans accents. #}
{% set statut = statut|default('Pas commencé')|trim %}
{% set statutNormalise = statut|lower|replace({'é': 'e'}) %}

{% set classe = 'pas-commence' %}

{% if statutNormalise == 'en cours' %}
    {% set classe = 'en-cours' %}
{% elseif statutNormalise == 'en pause' %}
    {% set classe = 'en-pause' %}
{% elseif statutNormalise in ['termine', 'termines'] %}
    {% set classe = 'termine' %}
{% elseif statutNormalise in ['abandonne', 'abandonnes'] %}
    {% set classe = 'abandonne' %}
{% endif %}

<span class="badge-lecture badge-lecture--{{ classe }}">
    {{ statut }}
</span>

{% extends 'base.html.twig' %}

{% block title %}Mes lectures | Incipit{% endblock %}

{% block body %}

<div class="espace-layout">

    {# Réutilise la navigation commune avec l’onglet Lectures actif. #}
    {% include 'components/_sidebar.html.twig' %}

    <main
        id="page-mes-lectures"
        class="espace-contenu page-lectures"
        data-pile-token="{{ csrf_token('pile_a_lire') }}"
    >

        <header class="bibliotheque-header">

            {# Permet de rechercher les livres affichés sans recharger la page. #}
            <form id="lectures-recherche-form" class="lectures-recherche" role="search">
                <img
                    src="{{ asset('images/rechercher.png') }}"
                    alt=""
                >

                <input
                    type="search"
                    id="lectures-recherche"
                    placeholder="Rechercher un titre ou un auteur..."
                    aria-label="Rechercher un livre"
                >
                <button type="submit" aria-label="Lancer la recherche" class="bouton-rechercher">Rechercher</button>
            </form>

            <img
                src="{{ asset('images/incipit.png') }}"
                alt="Incipit"
                class="bibliotheque-logo"
            >

        </header>

        <div class="lectures-introduction">

            <div>
                <h1 class="titre-page">Mes lectures</h1>
                <p class="sous-titre-page">Suivez et gérez toutes vos sessions de lecture.</p>
            </div>

            {# Ouvre le formulaire d’ajout déjà utilisé par la bibliothèque. #}
            <button
                type="button"
                id="ouvrir-ajout-lecture-page"
                class="lectures-bouton-ajouter"
                onclick="document.getElementById('modal-ajout-livre').showModal()"
            >
                Ajouter un livre
            </button>

        </div>

        {# Reprend les filtres et tris de la bibliothèque, en complément des compteurs par statut. #}
        {% include 'components/_filtres_livres.html.twig' with {genres: genres, prefixe: 'lectures-'} only %}

        <section
            class="lectures-statistiques"
            aria-label="Filtrer les livres par statut"
        >

            {# Définit les compteurs qui servent aussi de filtres par statut. #}
            {% set encadres = [
                {
                    filtre: 'tous',
                    titre: 'Livres possédés',
                    image: 'lecturestotales2'
                },
                {
                    filtre: 'en-cours',
                    titre: 'En cours',
                    image: 'encours'
                },
                {
                    filtre: 'termine',
                    titre: 'Terminées',
                    image: 'termine'
                },
                {
                    filtre: 'en-pause',
                    titre: 'En pause',
                    image: 'pause'
                },
                {
                    filtre: 'abandonne',
                    titre: 'Abandonnés',
                    image: 'abandonnee'
                },
                {
                    filtre: 'pas-commence',
                    titre: 'Pas commencé',
                    image: 'pascommence2'
                }
            ] %}

            {# Active le filtre « Livres possédés » par défaut et expose les autres statuts au JavaScript. #}
            {% for encadre in encadres %}

                <button
                    type="button"
                    class="lectures-statistique {{ loop.first ? 'actif' : '' }}"
                    data-filtre="{{ encadre.filtre }}"
                    aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                >

                    <span class="lectures-statistique-icone">
                        <img
                            src="{{ asset('images/' ~ encadre.image ~ '.png') }}"
                            alt=""
                        >
                    </span>

                    <span class="lectures-statistique-informations">
                        <span>{{ encadre.titre }}</span>

                        <strong data-compteur="{{ encadre.filtre }}">
                            {{ statistiques[encadre.filtre] }}
                        </strong>
                    </span>

                </button>

            {% endfor %}

        </section>

        {# Réunit le compteur, le repli des livres et les deux modes d’affichage. #}
        <div class="bibliotheque-outils lectures-outils">
            <p id="lectures-resultats-compteur" class="lectures-resultats-compteur" aria-live="polite"></p>
            <button type="button" id="bibliotheque-basculer-livres" class="bibliotheque-basculer-livres" aria-expanded="true" aria-controls="bibliotheque-liste-zone" aria-label="Masquer les livres">
                <span class="bibliotheque-ligne-repli" aria-hidden="true"></span>
                <span class="bibliotheque-fleche-repli" aria-hidden="true"></span>
            </button>

            <div class="bibliotheque-vues" aria-label="Mode d'affichage">
                <button
                    type="button"
                    id="vue-grille"
                    class="bibliotheque-vue actif"
                    aria-pressed="true"
                >
                    <img src="{{ asset('images/grille.png') }}" alt="">
                    Grille
                </button>

                <button
                    type="button"
                    id="vue-liste"
                    class="bibliotheque-vue"
                    aria-pressed="false"
                >
                    <img src="{{ asset('images/liste.png') }}" alt="">
                    Liste
                </button>
            </div>
        </div>

        <div id="bibliotheque-liste-zone">

        <section
            id="bibliotheque-livres"
            class="lectures-livres vue-grille"
            aria-label="Livres de ma collection"
        >

            {# Associe les statuts affichés aux valeurs attendues par les filtres JavaScript. #}
        {% set statutsFiltres = {
            'En cours': 'en-cours',
            'Terminé': 'termine',
            'En pause': 'en-pause',
            'Abandonné': 'abandonne'
        } %}

        {# Fournit les données de recherche et de statut aux cartes accessibles au clic et au clavier. #}
        {% for livre in livres %}

                {% set statutFiltre = statutsFiltres[livre.statut] ?? 'pas-commence' %}

                <article
                    class="bibliotheque-livre lectures-carte"
                    data-livre-id="{{ livre.id }}"
                    data-statut="{{ statutFiltre }}"
                    data-statut-lecture="{{ livre.statut }}"
                    data-genres="{{ livre.genres|e('html_attr') }}"
                    data-auteurs="{{ livre.auteurs|e('html_attr') }}"
                    data-date-ajout="{{ livre.date_creation ? livre.date_creation|date('U') : '' }}"
                    data-recherche="{{ (livre.titre ~ ' ' ~ livre.auteurs)|lower|e('html_attr') }}"
                    tabindex="0"
                    role="button"
                    aria-label="Voir les détails de {{ livre.titre }}"
                >

                    {# Affiche la couverture disponible ou un emplacement de remplacement. #}
                    {% if livre.image_couverture %}

                        <img
                            class="lectures-couverture"
                            src="{{ asset(livre.image_couverture) }}"
                            alt="Couverture de {{ livre.titre }}"
                        >

                    {% else %}

                        <div
                            class="lectures-couverture lectures-couverture-vide"
                            aria-label="Aucune couverture"
                        ></div>

                    {% endif %}

                    <div class="lectures-carte-informations">

                        <h2>{{ livre.titre }}</h2>
                        <button type="button" class="pile-ajouter-depuis-lectures" data-pile-action="ajouter" data-livre-id="{{ livre.id }}" {{ livre.pile_a_lire ? 'disabled' : '' }}>{{ livre.pile_a_lire ? 'Dans ma pile à lire' : 'Ajouter à ma pile à lire' }}</button>

                        <p class="lectures-auteur">
                            {{ livre.auteurs ?: 'Auteur non renseigné' }}
                        </p>

                        {# Réutilise le badge commun pour garder les mêmes couleurs de statut sur toutes les pages. #}
                        {% include 'components/_badge_lecture.html.twig' with {
                            statut: livre.statut
                        } only %}

                        {# Affiche uniquement les notes renseignées, en conservant les demi-étoiles et la note zéro. #}
                        {% if livre.note is not null %}

                            <p class="lectures-note">
                                <span aria-hidden="true">★</span>
                                {{ livre.note|number_format(1, ',', ' ')|replace({',0': ''}) }}/5
                            </p>

                        {% endif %}

                    </div>

                </article>

            {% endfor %}

        </section>

        {# Ce message est affiché par le JavaScript lorsqu’aucun livre ne correspond aux filtres. #}
        <p id="lectures-aucun-resultat" class="lectures-vide" hidden>
            Aucun livre ne correspond à ce filtre.
        </p>

        </div>

        {# Conserve l’accès aux titres retirés de la collection et à leur historique. #}
        <section class="bibliotheque-retires">
            <button
                type="button"
                id="basculer-retires"
                class="bibliotheque-retires-entete"
                aria-expanded="true"
                aria-controls="contenu-retires"
            >
                <img src="{{ asset('images/poubelle.png') }}" alt="">

                <span class="bibliotheque-retires-titre">
                    <strong>Livres retirés de ma collection</strong>
                    <small>
                        Ces livres ne sont plus dans votre bibliothèque,
                        mais leur historique est conservé.
                    </small>
                </span>

                <span id="chevron-retires" aria-hidden="true">⌃</span>
            </button>

            <div id="contenu-retires" class="bibliotheque-retires-liste">
                {% for livre in livresRetires %}
                    <article class="bibliotheque-livre-retire">
                        {% if livre.image_couverture %}
                            <img
                                src="{{ asset(livre.image_couverture) }}"
                                alt="Couverture de {{ livre.titre }}"
                            >
                        {% else %}
                            <div class="bibliotheque-couverture-retire-vide"></div>
                        {% endif %}

                        <div>
                            <h3>{{ livre.titre }}</h3>
                            <p>{{ livre.auteurs ?: 'Auteur non renseigné' }}</p>
                        </div>
                    </article>
                {% else %}
                    <p class="bibliotheque-vide">
                        Aucun livre retiré de votre collection.
                    </p>
                {% endfor %}
            </div>
        </section>
    </main>

</div>

{# Charge les fenêtres communes nécessaires à l’ajout et à la consultation des livres. #}
{% include 'livre/_modal_ajout.html.twig' %}
{% include 'livre/_modal_details.html.twig' %}

{% endblock %}

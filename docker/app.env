# Valeurs publiques réservées au développement Docker, sans accès à la production.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=incipit-docker-local-development-only
DATABASE_URL="mysql://incipit:incipit_local@database:3306/incipit_demo?serverVersion=8.4.0&charset=utf8mb4"
DEFAULT_URI=http://localhost:8080
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=incipit@example.invalid
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=incipit_demo_logs
GOOGLE_BOOKS_API_KEY=
SERPAPI_API_KEY=
